# Postgres. Local: `npm run db:local` sobe um Postgres embutido em localhost:5433.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/flash"
# Conexão direta (sem pooler). Usada pelas migrations e pelo LISTEN do tempo real.
# Na Neon é a URL "unpooled"; localmente pode ficar igual à DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://postgres:postgres@localhost:5433/flash"

# Chave de 32 bytes em base64 para cifrar segredos de 2FA no banco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Obrigatória em produção; em desenvolvimento há um valor padrão.
ENCRYPTION_KEY=""

# Atrás de um proxy confiável (Vercel, Nginx), o IP do cliente vem deste cabeçalho.
# Deixe vazio se a aplicação ficar exposta diretamente (o cabeçalho poderia ser forjado).
TRUSTED_IP_HEADER="x-forwarded-for"

# Busca de CEP no cadastro de contato: "remote" (padrão: ViaCEP, com BrasilAPI de reserva),
# "mock" (CEPs fixos, para testes) ou "off" (servidor sem saída de internet: preenchimento manual).
CEP_PROVIDER="remote"

# Job de limpeza diário (vercel.json → /api/cron/limpeza). A Vercel envia "Authorization: Bearer $CRON_SECRET".
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))". Vazio = rota desligada.
CRON_SECRET=""

# Manutenção > "Limpar a base" e "Dados de teste": liberados fora de produção; em produção só com "true".
# Solicitação de acesso: confere no DNS se o domínio do e-mail recebe mensagens. "off" desliga
# (servidor sem saída de internet). E-mails temporários são recusados de qualquer forma.
EMAIL_DOMAIN_CHECK="dns"

ALLOW_DATA_RESET="false"
# Manutenção > "Dados de teste" sozinho (só acrescenta contatos fictícios): útil numa demonstração em produção.
ALLOW_DEMO_DATA="false"
